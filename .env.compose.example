# 复制为 .env 后再执行 docker compose。仅用于本地虚构数据环境。
AUTH_SECRET=replace-with-at-least-32-random-characters
# 使用 `openssl rand -hex 32` 生成；生产环境必填，开发演示环境也建议设置。
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=primary
BACKEND_PORT=8787
NODE_ENV=development
SEED_DEMO_DATA=true
CORS_ALLOWED_ORIGINS=*
GENERAL_RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false
LOG_LEVEL=info
METRICS_TOKEN=

# 仅供本地 MySQL 学习和迁移验证。正式环境必须由学校或云平台提供独立密钥。
MYSQL_EXPOSE_PORT=3306
MYSQL_DATABASE=shuzhi
MYSQL_USER=shuzhi_app
MYSQL_PASSWORD=replace-with-a-long-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=20
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_QUEUE_LIMIT=1000
