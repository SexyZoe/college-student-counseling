/* app.wxss - 数智心港湾 全局糖果色主题 */

page {
  /* 主色调 - 糖果色系 */
  --pink: #f4a3a8;
  --pink-light: #fef0f2;
  --pink-dark: #e88a8f;
  --mint: #8fc8b5;
  --mint-light: #e8f6f1;
  --mint-dark: #6db8a0;
  --sky: #8fc1e0;
  --sky-light: #e8f3fa;
  --sky-dark: #6ba8d0;
  --lavender: #b8a9d4;
  --lavender-light: #f2eef8;
  --lavender-dark: #9f8ec0;
  --yellow: #f5d79e;
  --yellow-light: #fef9f0;
  --yellow-dark: #d4b670;
  --peach: #f7b7a0;
  --peach-light: #fef3ee;
  --peach-dark: #e0987a;

  /* 背景与文本 */
  --bg: #faf7f2;
  --bg-card: #ffffff;
  --bg-soft: #f7f2ea;
  --text: #4a4a4a;
  --text-secondary: #8a8a8a;
  --text-light: #b5a5a5;
  --border: #f0e8dc;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0,0,0,0.08);

  /* 全局基础样式 */
  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

/* === 通用布局 === */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-more {
  display: flex;
  align-items: center;
}

.more-text {
  font-size: 26rpx;
  color: var(--text-light);
  margin-left: 6rpx;
}

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-pink { background: var(--pink-light); color: var(--pink-dark); }
.tag-mint { background: var(--mint-light); color: var(--mint-dark); }
.tag-sky { background: var(--sky-light); color: var(--sky-dark); }
.tag-lavender { background: var(--lavender-light); color: var(--lavender); }
.tag-yellow { background: var(--yellow-light); color: var(--yellow-dark); }
.tag-peach { background: var(--peach-light); color: var(--peach-dark); }

/* === 按钮 === */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: var(--radius-xl);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  color: #fff;
}

.btn-primary { background: linear-gradient(135deg, var(--pink), var(--peach)); }
.btn-mint { background: linear-gradient(135deg, var(--mint), var(--mint-dark)); }
.btn-sky { background: linear-gradient(135deg, var(--sky), var(--sky-dark)); }
.btn-lavender { background: linear-gradient(135deg, var(--lavender), var(--lavender-dark)); }

/* === Flex 工具 === */
.flex-row { display: flex; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

/* === 文本工具 === */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 20rpx; }
.text-lg { font-size: 36rpx; }

.text-pink { color: var(--pink); }
.text-mint { color: var(--mint); }
.text-sky { color: var(--sky); }
.text-lavender { color: var(--lavender); }
.text-yellow { color: var(--yellow-dark); }
.text-peach { color: var(--peach); }

/* === 间距工具 === */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }

.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }

/* === 安全区 === */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}