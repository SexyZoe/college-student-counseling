/* pages/article/list.wxss */

.article-container {
  min-height: 100vh;
  background-color: #faf7f2;
}

/* 收藏筛选开关 */
.fav-toggle {
  display: flex; align-items: center; justify-content: center;
  padding: 14rpx 0 8rpx; gap: 8rpx;
}
.fav-toggle-text { font-size: 24rpx; }

/* 分类标签 */
.category-section {
  background-color: #ffffff;
  padding: 0 0 20rpx;
  position: sticky; top: 0; z-index: 100;
}
.category-scroll { width: 100%; }
.category-list {
  display: flex; padding: 0 30rpx; white-space: nowrap;
}
.category-item {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 14rpx 28rpx; margin-right: 16rpx;
  border-radius: 30rpx; background-color: #faf7f2;
}
.category-item.active { background-color: #f4a3a8; }
.category-text { font-size: 26rpx; color: #8a8a8a; }
.category-item.active .category-text { color: #ffffff; }
.category-count {
  font-size: 20rpx; color: #f4a3a8; background: #fff;
  border-radius: 20rpx; padding: 2rpx 10rpx; min-width: 30rpx; text-align: center;
}
.category-item.active .category-count {
  color: #ffffff; background: rgba(255,255,255,.25);
}

/* 文章列表 */
.article-list { padding: 30rpx; }
.article-card {
  background-color: #ffffff; border-radius: 20rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.article-cover { width: 100%; height: 300rpx; }
.article-content { padding: 20rpx 30rpx 30rpx; }

/* 标签行：分类标签 + 收藏星标 */
.article-top-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx;
}
.article-tag {
  display: inline-block; padding: 6rpx 14rpx; border-radius: 6rpx;
  font-size: 22rpx; background-color: rgba(244, 163, 168, 0.1); color: #f4a3a8;
}
.fav-star { padding: 4rpx; }

.article-title {
  font-size: 32rpx; font-weight: bold; color: #4a4a4a;
  margin-bottom: 12rpx; display: block;
}
.article-summary {
  font-size: 26rpx; color: #b0b0b0;
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 16rpx;
}
.article-meta {
  display: flex; justify-content: space-between; align-items: center;
}
.meta-date { font-size: 24rpx; color: #b0b0b0; }
.meta-views { display: flex; align-items: center; }
.meta-num { font-size: 24rpx; color: #b0b0b0; margin-left: 8rpx; }

/* 空状态 */
.empty-section {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 100rpx 30rpx;
}
.empty-icon-box {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background-color: #faf7f2; display: flex; align-items: center;
  justify-content: center; margin-bottom: 30rpx;
}
.empty-text { font-size: 32rpx; color: #8a8a8a; margin-bottom: 16rpx; }
.empty-tip { font-size: 26rpx; color: #b0b0b0; }
