<view class="article-container">
  <!-- 分类标签 -->
  <view class="category-section">
    <!-- 仅看收藏开关 -->
    <view class="fav-toggle" bindtap="onToggleFavoritesOnly">
      <van-icon name="{{showFavoritesOnly ? 'star' : 'star-o'}}" size="18px" color="{{showFavoritesOnly ? '#FFD700' : '#999'}}" />
      <text class="fav-toggle-text" style="color: {{showFavoritesOnly ? '#FFD700' : '#999'}};">仅看收藏</text>
    </view>
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="category-list">
        <view
          class="category-item {{currentCategory === item.name ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="name"
          bindtap="onCategoryChange"
          data-category="{{item.name}}"
        >
          <text class="category-text">{{item.name}}</text>
          <text class="category-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 文章列表 -->
  <view class="article-list" wx:if="{{filteredList.length > 0}}">
    <view class="article-card" wx:for="{{filteredList}}" wx:key="id" bindtap="onArticleTap" data-id="{{item.id}}">
      <image class="article-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="article-content">
        <view class="article-top-row">
          <view class="article-tag">{{item.category}}</view>
          <!-- 收藏星标 -->
          <view class="fav-star" catchtap="onToggleFav" data-id="{{item.id}}">
            <van-icon name="{{item.isFav ? 'star' : 'star-o'}}" size="20px" color="{{item.isFav ? '#FFD700' : '#ccc'}}" />
          </view>
        </view>
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
        <view class="article-meta">
          <text class="meta-date">{{item.author}} · {{item.createTime}}</text>
          <view class="meta-views">
            <van-icon name="eye-o" size="12px" color="#999" />
            <text class="meta-num">{{item.views}}人阅读</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-section" wx:else>
    <view class="empty-icon-box">
      <van-icon name="newspaper-o" size="40px" color="#999" />
    </view>
    <text class="empty-text" wx:if="{{showFavoritesOnly}}">暂无收藏文章</text>
    <text class="empty-text" wx:else>{{currentCategory === '全部' ? '暂无文章' : '暂无' + currentCategory + '类文章'}}</text>
    <text class="empty-tip" wx:if="{{showFavoritesOnly}}">点击文章卡片右上角星标即可收藏</text>
    <text class="empty-tip" wx:else>敬请期待更多精彩内容</text>
  </view>
</view>
