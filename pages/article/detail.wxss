/* pages/article/detail.wxss */

.detail-container {
  min-height: 100vh;
  background-color: #faf7f2;
  padding-bottom: 100rpx;
}

/* 文章头部 */
.article-header {
  background-color: #ffffff;
  position: relative;
}

.article-cover {
  width: 100%;
  height: 400rpx;
}

.header-content {
  padding: 30rpx;
}

.article-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #4a4a4a;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.article-info {
  display: flex;
  align-items: center;
}

.info-author {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-right: 20rpx;
}

.info-date {
  font-size: 26rpx;
  color: #b0b0b0;
  margin-right: 20rpx;
}

.info-category {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background-color: rgba(91, 155, 213, 0.1);
  color: #f4a3a8;
}

/* 文章正文 */
.article-body {
  background-color: #ffffff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.article-content {
  font-size: 30rpx;
  color: #4a4a4a;
  line-height: 1.8;
}

.article-content p {
  margin-bottom: 20rpx;
}

.article-content h3 {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a4a4a;
  margin: 30rpx 0 20rpx;
}

.article-content strong {
  color: #f4a3a8;
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-text {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 8rpx;
}

.action-item.collected .action-text {
  color: #f5d79e;
}