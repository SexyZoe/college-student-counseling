.submit-container { min-height: 100vh; background-color: #faf7f2; padding: 20rpx 30rpx; padding-bottom: 140rpx; }
.form-card { background-color: #fff; border-radius: 20rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04); }
.form-label { font-size: 30rpx; font-weight: bold; color: #4a4a4a; margin-bottom: 16rpx; }
.picker-display { display: flex; align-items: center; justify-content: space-between; padding: 20rpx; background: #faf7f2; border-radius: 12rpx; font-size: 28rpx; color: #4a4a4a; }
.submit-btn { margin: 40rpx 0; padding: 30rpx; border-radius: 50rpx; text-align: center; background: linear-gradient(135deg, #f4a3a8, #f7b7a0); }
.btn-text { font-size: 32rpx; color: #fff; }