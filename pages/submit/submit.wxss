.submit-container { min-height: 100vh; background-color: #faf7f2; padding: 20rpx 30rpx; padding-bottom: 140rpx; }

/* 表单卡片 */
.form-card { background-color: #fff; border-radius: 20rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04); }
.form-label { font-size: 30rpx; font-weight: bold; color: #4a4a4a; margin-bottom: 16rpx; }
.word-count { font-size: 22rpx; color: #bbb; font-weight: normal; }

/* 分类选择器 */
.picker-display { display: flex; align-items: center; justify-content: space-between; padding: 20rpx; background: #faf7f2; border-radius: 12rpx; font-size: 28rpx; color: #4a4a4a; }

/* 提交按钮 */
.submit-btn { margin: 40rpx 0; padding: 30rpx; border-radius: 50rpx; text-align: center; background: linear-gradient(135deg, #f4a3a8, #f7b7a0); }
.btn-text { font-size: 32rpx; color: #fff; }

/* 确认弹窗 */
.confirm-body { padding: 20rpx; }
.confirm-row { display: flex; align-items: baseline; padding: 12rpx 0; border-bottom: 1rpx solid #f0ebe0; }
.confirm-row:last-child { border-bottom: none; }
.confirm-label { font-size: 26rpx; color: #888; margin-right: 12rpx; white-space: nowrap; }
.confirm-val { font-size: 26rpx; color: #444; flex: 1; }
.confirm-note { display: block; margin-top: 16rpx; font-size: 22rpx; color: #f4a3a8; text-align: center; }

/* 成功引导弹窗 */
.success-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 200;
  display: flex; align-items: center; justify-content: center;
}
.success-card {
  width: 580rpx; background: #fff; border-radius: 24rpx;
  padding: 50rpx 40rpx; display: flex; flex-direction: column; align-items: center;
}
.success-icon { font-size: 64rpx; margin-bottom: 24rpx; }
.success-title { font-size: 34rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.success-desc { font-size: 26rpx; color: #666; text-align: center; margin-bottom: 8rpx; }
.success-hint { font-size: 22rpx; color: #999; margin-bottom: 32rpx; }
.success-btn {
  width: 100%; padding: 24rpx; border-radius: 44rpx;
  text-align: center; font-size: 28rpx; color: #fff;
  background: linear-gradient(135deg, #f4a3a8, #8fc8b5);
}

/* 提交历史 */
.submission-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid #f0ebe0;
}
.submission-item:last-child { border-bottom: none; }
.sub-info { flex: 1; }
.sub-title { font-size: 28rpx; color: #444; font-weight: 600; display: block; margin-bottom: 4rpx; }
.sub-meta { font-size: 22rpx; color: #999; }
.sub-status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 500; }
.status-pending { color: #f5a623; background: #fef6e8; }
.status-approved { color: #8fc8b5; background: #f0faf5; }
.status-rejected { color: #d96b72; background: #fef0f2; }
