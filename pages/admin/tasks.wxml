<view class="workspace"><view class="workspace-head admin-head"><text class="head-title">测评任务管理</text><text class="head-sub">任务绑定固定量表版本，发布后不直接修改历史规则</text></view><view class="form-card"><text class="form-label">任务名称</text><input class="form-input" value="{{title}}" bindinput="onTitle" placeholder="请输入任务名称"/><text class="form-label">选择量表</text><view class="filter-row" style="padding:0;"><view wx:for="{{assessments}}" wx:key="id" class="filter-item {{assessmentId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectAssessment">{{item.id}}.{{item.name}}</view></view><text class="form-label">截止日期</text><input class="form-input" value="{{deadline}}" bindinput="onDeadline" placeholder="YYYY-MM-DD"/><text class="form-label">发布范围</text><view class="form-input">{{target}}（演示）</view><view class="primary-btn admin-btn" style="margin:28rpx 0 0;" bindtap="createTask">保存草稿</view></view><view class="section"><view class="section-head"><text class="section-title">任务列表</text></view><view class="panel" wx:for="{{tasks}}" wx:key="id"><view class="head-row"><view class="card-main"><text class="card-title">{{item.title}}</text><view class="card-meta"><text>量表 {{item.assessmentId}}</text><text>{{item.deadline}}</text><text>{{item.status}}</text></view></view><view class="status-action" wx:if="{{item.status === '草稿'}}" data-id="{{item.id}}" bindtap="publish">发布</view></view></view></view></view>
