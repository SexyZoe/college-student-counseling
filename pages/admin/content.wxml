<view class="workspace"><view class="workspace-head admin-head"><text class="head-title">内容审核与发布</text><text class="head-sub">确保作者、审核人、发布时间和内容边界可追溯</text></view><view class="filter-row"><view wx:for="{{contentTypes}}" wx:key="*this" class="filter-item {{activeType === item ? 'active' : ''}}" data-type="{{item}}" bindtap="onType">{{item}}</view></view><view class="filter-row" style="padding-top:0;"><view wx:for="{{tabs}}" wx:key="*this" class="filter-item {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="onTab">{{item}}</view></view><view class="section"><view class="panel" wx:for="{{filtered}}" wx:key="id"><view class="head-row"><view class="card-main"><text class="card-title">{{item.title}}</text><text class="card-sub">{{item.summary}}</text><view class="card-meta"><text>{{item.category}}</text><text>作者：{{item.author}}</text><text>审核：{{item.reviewer}}</text></view></view></view><view class="head-row" style="justify-content:flex-end;margin-top:20rpx;" wx:if="{{item.status === '待审核'}}"><view class="status-action" data-id="{{item.id}}" data-status="已发布" bindtap="review">审核发布</view><view class="status-action status-reject" data-id="{{item.id}}" data-status="已退回" bindtap="review">退回修改</view></view></view><view class="empty" wx:if="{{filtered.length === 0}}">当前没有{{activeTab}}{{activeType}}</view></view><view class="notice">课程思政与价值教育内容不得用于替代心理测评，也不得将学生的观点差异直接标记为心理风险。</view></view>
