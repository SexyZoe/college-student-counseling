<view class="workspace"><view class="workspace-head admin-head"><text class="head-title">学期与组织数据</text><text class="head-sub">历史关系新增留存，不覆盖既往测评归属</text></view><view class="filter-row"><view wx:for="{{tabs}}" wx:key="*this" class="filter-item {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="onTab">{{item}}</view></view>
<view wx:if="{{activeTab === '学期'}}"><view class="form-card"><text class="form-label">新学期名称</text><input class="form-input" value="{{semesterName}}" bindinput="onSemesterName" placeholder="例如：2027-2028学年第一学期"/><text class="form-label">开始日期</text><input class="form-input" value="{{startDate}}" bindinput="onStart" placeholder="YYYY-MM-DD"/><text class="form-label">结束日期</text><input class="form-input" value="{{endDate}}" bindinput="onEnd" placeholder="YYYY-MM-DD"/><view class="primary-btn admin-btn" style="margin:28rpx 0 0;" bindtap="createSemester">创建学期</view></view><view class="section"><view class="panel" wx:for="{{semesters}}" wx:key="id"><view class="head-row"><view class="card-main"><text class="card-title">{{item.name}}</text><view class="card-meta"><text>{{item.startDate}} 至 {{item.endDate}}</text><text>{{item.status}}</text></view></view><view class="status-action" wx:if="{{item.status !== '当前学期'}}" data-id="{{item.id}}" bindtap="setCurrent">设为当前</view></view></view></view></view>
<view wx:if="{{activeTab === '学生'}}" class="section"><view class="list-card" wx:for="{{students}}" wx:key="studentId"><view class="card-main"><text class="card-title">{{item.studentName}}　{{item.studentId}}</text><view class="card-meta"><text>{{item.className}}</text><text>{{item.major}}</text></view></view></view></view>
<view wx:if="{{activeTab === '分配'}}" class="section"><view class="panel"><text class="card-title">王辅导员（T001）</text><view class="card-meta"><text>计科2401</text><text>人工智能2401</text><text>当前学期</text></view></view><view class="notice" style="margin:0;">正式系统应支持按学期新增辅导员—班级关系，并在关系变化后及时撤销旧数据权限。</view></view>
<view wx:if="{{activeTab === '导入'}}"><view class="notice">支持 CSV/XLSX 模板。当前小程序只完成文件选择和批次记录；字段校验、差异预览、确认写入及回滚必须由后端完成。</view><view class="primary-btn admin-btn" bindtap="chooseImport">选择 CSV / Excel 文件</view><view class="section"><view class="panel" wx:for="{{importJobs}}" wx:key="id"><text class="card-title">{{item.fileName}}</text><view class="card-meta"><text>{{item.status}}</text><text>{{item.createdAt}}</text></view></view></view></view></view>
