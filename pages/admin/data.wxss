@import "./common.wxss";
.backend-state { margin:18rpx 24rpx; padding:16rpx 22rpx; border-radius:18rpx; background:#fff1e6; color:#a56b40; font-size:22rpx; }
.backend-state.online { background:#e9f5f0; color:#4d8b75; }
.import-actions { display:flex; gap:18rpx; margin:24rpx; }
.import-actions .primary-btn,.import-actions .secondary-btn { flex:1; margin:0; text-align:center; box-sizing:border-box; }
.secondary-btn { padding:22rpx 20rpx; border:1rpx solid #75668d; color:#75668d; border-radius:44rpx; font-size:25rpx; }
.batch-detail { margin:24rpx; border:2rpx solid #e4deea; }
.batch-stats { display:flex; flex-wrap:wrap; gap:18rpx; margin-top:18rpx; color:#6e6e76; font-size:22rpx; }
.error-text { color:#c85d68; }
.error-row,.preview-row { display:flex; flex-direction:column; gap:6rpx; margin-top:16rpx; padding:16rpx; border-radius:14rpx; background:#fff1f1; color:#9d4d55; font-size:22rpx; }
.preview-row { background:#f7f5f9; color:#544e5d; }
.muted { color:#999; font-size:20rpx; }
.batch-buttons { display:flex; justify-content:flex-end; gap:16rpx; margin-top:20rpx; }
.danger-action { padding:8rpx 16rpx; border-radius:20rpx; color:#fff; background:#c85d68; font-size:21rpx; }
.loading-mask { position:fixed; left:0; right:0; top:0; bottom:0; z-index:100; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,.78); color:#655b7b; font-size:26rpx; }
