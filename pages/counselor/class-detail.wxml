<view class="workspace"><view class="workspace-head"><text class="head-title">{{className}}</text><text class="head-sub">只展示必要摘要，不提供公开排名</text></view><view class="stat-grid"><view class="stat-card"><text class="stat-value">{{summary.total}}</text><text class="stat-label">学生</text></view><view class="stat-card"><text class="stat-value">{{summary.rate}}%</text><text class="stat-label">完成率</text></view><view class="stat-card"><text class="stat-value">{{summary.average}}</text><text class="stat-label">状态指数均值</text></view><view class="stat-card"><text class="stat-value">5</text><text class="stat-label">统计维度</text></view></view><view class="section"><view class="panel"><text class="card-title">风险等级分布</text><view class="distribution-row"><view class="distribution-item" wx:for="{{riskDistribution}}" wx:key="label"><text class="distribution-value" style="color:{{item.color}};">{{item.value}}</text><text class="distribution-label">{{item.label}}</text></view></view></view><view class="panel"><text class="card-title">班级五维平均</text><view class="dimension-row" wx:for="{{dimensions}}" wx:key="label"><view class="progress-copy"><text>{{item.label}}</text><text>{{item.value}}</text></view><view class="progress-line"><view class="progress-value" style="width:{{item.value}}%;"></view></view></view><text class="chart-note">聚合数据仅用于支持工作，不用于公开排名或医疗诊断。</text></view></view><view class="filter-row"><view wx:for="{{filters}}" wx:key="*this" class="filter-item {{activeFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="onFilter">{{item}}</view></view><view class="section"><view class="list-card" wx:for="{{filtered}}" wx:key="studentId" data-id="{{item.studentId}}" bindtap="goStudent"><view class="card-main"><text class="card-title">{{item.studentName}}　{{item.studentId}}</text><view class="card-meta"><text>{{item.completion}}</text><text class="{{item.riskLevel === '较高风险' || item.riskLevel === '紧急风险' ? 'risk-high' : (item.riskLevel === '关注' ? 'risk-watch' : 'risk-normal')}}">{{item.riskLevel}}</text><text wx:if="{{item.latestScore}}">指数 {{item.latestScore}}</text></view></view><van-icon name="arrow" size="15px" color="#bbb" /></view><view class="empty" wx:if="{{filtered.length === 0}}">没有符合条件的学生</view></view></view>
