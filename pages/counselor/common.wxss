.workspace { min-height:100vh; padding-bottom:50rpx; background:#f6f8f7; }
.workspace-head { padding:42rpx 32rpx; color:#fff; background:linear-gradient(135deg,#4d8d7a,#6ba8d0); }
.head-row { display:flex; align-items:center; justify-content:space-between; }.head-title { display:block; font-size:38rpx; font-weight:700; }.head-sub { display:block; margin-top:8rpx; color:rgba(255,255,255,.82); font-size:24rpx; }.logout-link { font-size:23rpx; padding:8rpx 18rpx; border:1rpx solid rgba(255,255,255,.5); border-radius:24rpx; }
.stat-grid { display:flex; flex-wrap:wrap; padding:22rpx 22rpx 0; }.stat-card { width:calc(50% - 44rpx); margin:10rpx; padding:26rpx 12rpx; text-align:center; border-radius:18rpx; background:#fff; }.stat-value { display:block; font-size:44rpx; font-weight:800; color:#4d8d7a; }.stat-label { display:block; color:#888; font-size:23rpx; margin-top:5rpx; }
.section { margin:22rpx 30rpx; }.section-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:15rpx; }.section-title { font-size:31rpx; font-weight:700; color:#333; }.section-more { color:#6b9b8d; font-size:24rpx; }
.panel,.list-card { padding:26rpx; margin-bottom:16rpx; border-radius:19rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(0,0,0,.035); }
.list-card { display:flex; align-items:center; }.card-main { flex:1; }.card-title { display:block; color:#333; font-size:28rpx; font-weight:650; }.card-sub { display:block; margin-top:6rpx; color:#999; font-size:22rpx; }.card-meta { display:flex; gap:18rpx; margin-top:12rpx; color:#777; font-size:23rpx; }
.risk-normal { color:#4d8d7a; }.risk-watch { color:#c58b38; }.risk-high { color:#d45f68; }.badge { display:inline-block; padding:5rpx 14rpx; border-radius:18rpx; font-size:21rpx; background:#eef4f2; color:#4d8d7a; }
.action-grid { display:flex; flex-wrap:wrap; padding:0 20rpx; }.action-item { width:calc(50% - 56rpx); margin:10rpx; padding:26rpx 18rpx; border-radius:18rpx; color:#426b60; background:#e8f6f1; font-size:26rpx; font-weight:600; }
.progress-line { height:14rpx; overflow:hidden; background:#edf0ef; border-radius:8rpx; margin:18rpx 0 8rpx; }.progress-value { height:100%; border-radius:8rpx; background:linear-gradient(90deg,#8fc8b5,#8fc1e0); }.progress-copy { display:flex; justify-content:space-between; color:#888; font-size:22rpx; }
.filter-row { display:flex; gap:12rpx; padding:20rpx 30rpx; overflow-x:auto; white-space:nowrap; }.filter-item { padding:10rpx 22rpx; color:#777; background:#fff; border-radius:28rpx; font-size:23rpx; }.filter-item.active { color:#fff; background:#4d8d7a; }
.form-card { margin:24rpx 30rpx; padding:30rpx; border-radius:20rpx; background:#fff; }.form-label { display:block; margin:24rpx 0 10rpx; color:#555; font-size:25rpx; font-weight:600; }.form-input,.form-textarea { box-sizing:border-box; width:100%; padding:20rpx; border:1rpx solid #e5e8e7; border-radius:14rpx; background:#fafbfb; font-size:26rpx; }.form-textarea { min-height:200rpx; }.primary-btn { margin:30rpx; padding:22rpx; text-align:center; color:#fff; border-radius:40rpx; background:linear-gradient(135deg,#4d8d7a,#6ba8d0); font-size:28rpx; }.notice { margin:20rpx 30rpx; padding:20rpx; color:#777; background:#fff7e8; border-radius:15rpx; font-size:22rpx; line-height:1.7; }
.empty { padding:60rpx 20rpx; text-align:center; color:#aaa; font-size:25rpx; }
