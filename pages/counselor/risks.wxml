<view class="workspace"><view class="workspace-head"><text class="head-title">风险事件与跟进</text><text class="head-sub">系统仅提供提示，最终判断与处置由有资质人员完成</text></view><view class="filter-row"><view wx:for="{{filters}}" wx:key="*this" class="filter-item {{activeFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="onFilter">{{item}}</view></view><view class="section"><view class="list-card" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="goFollowup"><view class="card-main"><view class="head-row"><text class="card-title">{{item.studentName}} · {{item.className}}</text><text class="risk-high">{{item.level}}</text></view><text class="card-sub">{{item.summary}}</text><view class="card-meta"><text>{{item.status}}</text><text>{{item.createdAt}}</text></view></view><van-icon name="arrow" size="15px" color="#bbb" /></view><view class="empty" wx:if="{{filtered.length === 0}}">当前筛选下没有风险事件</view></view></view>
