.policy-page { min-height:100vh; padding-bottom:40rpx; background:#faf7f2; }
.policy-hero { padding:48rpx 32rpx; background:linear-gradient(135deg,#8fc8b5,#8fc1e0); display:flex; flex-direction:column; }
.hero-title { color:#fff; font-size:38rpx; font-weight:700; }
.hero-sub { color:rgba(255,255,255,.8); font-size:24rpx; margin-top:10rpx; }
.policy-card,.consent-card { margin:24rpx 30rpx; padding:30rpx; border-radius:22rpx; background:#fff; box-shadow:0 4rpx 16rpx rgba(0,0,0,.04); }
.policy-title { display:block; font-size:30rpx; font-weight:700; color:#333; margin-bottom:12rpx; }
.policy-text { display:block; font-size:26rpx; line-height:1.9; color:#666; }
.consent-row { display:flex; align-items:center; justify-content:space-between; }
.consent-copy { flex:1; padding-right:20rpx; }
.consent-hint,.consent-time { display:block; color:#999; font-size:23rpx; }
.consent-time { margin-top:18rpx; }
