<view class="result-container">
  <!-- 头部：分数 + wellbeing 指数环 -->
  <view class="result-header" style="background: linear-gradient(135deg, {{levelColor}}30, {{levelColor}}10);">
    <view class="score-ring-wrapper">
      <view class="score-circle" style="border-color: {{levelColor}};">
        <text class="score-number">{{score}}</text>
        <text class="score-total">/ {{total}}</text>
      </view>
      <view class="wellbeing-ring" style="border-color: {{levelColor}};">
        <text class="wellbeing-value">{{wellbeingIndex}}</text>
        <text class="wellbeing-label">幸福指数</text>
      </view>
    </view>
    <text class="result-level" style="color: {{levelColor}};">{{level}}</text>
    <text class="result-desc">风险分层：{{riskLevel}}</text>
    <text class="result-desc">{{levelDesc}}</text>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer-bar">
    <van-icon name="info-o" size="14px" color="#999" />
    <text>本结果仅用于心理健康教育和风险筛查参考，不构成医疗诊断。</text>
  </view>

  <view class="disclaimer-bar" wx:if="{{triggeredRules.length > 0}}">
    <van-icon name="warning-o" size="14px" color="#d96b72" />
    <text>关键题规则已触发，系统已生成待人工复核提示；如感到自身安全受到威胁，请立即联系可信任的人或紧急求助渠道。</text>
  </view>

  <!-- 五维雷达图 -->
  <view class="result-section" wx:if="{{dimensions.length >= 3}}">
    <text class="section-title">五维雷达图</text>
    <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
  </view>

  <!-- 五维详情卡片 -->
  <view class="result-section" wx:if="{{dimCards.length}}">
    <text class="section-title">各维度详情</text>
    <view class="dim-cards">
      <view class="dim-card" wx:for="{{dimCards}}" wx:key="label">
        <view class="dim-card-header">
          <text class="dim-label">{{item.label}}</text>
          <text class="dim-trend" wx:if="{{trendArrows[index]}}">{{trendArrows[index]}}</text>
          <text class="dim-status" style="color: {{item.statusColor}};">{{item.status}}</text>
        </view>
        <view class="dim-bar-track">
          <view class="dim-bar-fill" style="width: {{item.value}}%; background: {{item.barColor}};"></view>
        </view>
        <view class="dim-card-footer">
          <text class="dim-value">{{item.value}}</text>
          <text class="dim-unit">/ 100</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 最弱维度建议 -->
  <view class="result-section" wx:if="{{lowestDimLabel}}">
    <view class="lowest-dim-card">
      <van-icon name="point-gift-o" size="20px" color="#f4a3a8" />
      <view class="lowest-dim-body">
        <text class="lowest-dim-title">改善重点：{{lowestDimLabel}}</text>
        <text class="lowest-dim-advice">{{lowestDimAdvice}}</text>
      </view>
    </view>
  </view>

  <!-- 测评分析 -->
  <view class="result-section">
    <text class="section-title">测评分析</text>
    <text class="analysis-text">{{analysis}}</text>
  </view>

  <view class="support-card" bindtap="goHelp">
    <view>
      <text class="support-title">需要进一步支持？</text>
      <text class="support-text">查看校心理中心、辅导员和紧急求助渠道</text>
    </view>
    <van-icon name="arrow" size="16px" color="#999" />
  </view>

  <!-- 改善方案 -->
  <view class="result-section">
    <text class="section-title">个性化建议</text>
    <view class="suggestion-list">
      <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="*this">
        <view class="suggestion-dot" style="background-color: {{levelColor}};"></view>
        <text class="suggestion-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 历史趋势入口 -->
  <view class="result-section">
    <view class="history-entry" bindtap="viewHistory">
      <view class="history-left">
        <van-icon name="chart-trending-o" size="20px" color="#f4a3a8" />
        <text>查看历史趋势</text>
        <text class="history-count" wx:if="{{historyCount > 1}}">(共{{historyCount}}次)</text>
      </view>
      <van-icon name="arrow" size="14px" color="#999" />
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="result-actions">
    <view class="action-btn btn-secondary" bindtap="viewHistory">
      <text>历史趋势</text>
    </view>
    <view class="action-btn btn-primary" bindtap="goBack">
      <text>返回测评</text>
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>
