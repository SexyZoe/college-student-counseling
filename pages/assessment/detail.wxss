.page {
  min-height: 100vh;
  background-color: #faf7f2;
  padding-bottom: 40rpx;
}

/* Progress Header */
.progress-header {
  background-color: #fff;
  padding: 30rpx 30rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.progress-bar {
  flex: 1; height: 10rpx;
  background-color: #f0ebe3; border-radius: 10rpx; overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #f4a3a8, #f7b7a0);
  border-radius: 10rpx;
  transition: width 0.4s ease;
}
.progress-text {
  font-size: 24rpx; color: #bbb; white-space: nowrap;
}

/* 草稿保存状态指示器 */
.draft-indicator {
  display: flex; align-items: center; justify-content: center;
  padding: 14rpx 0; background: #f0faf5;
}
.draft-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #8fc8b5; margin-right: 10rpx;
}
.draft-text {
  font-size: 22rpx; color: #8fc8b5;
}

/* Question Area */
.question-area { padding: 40rpx 30rpx; }
.question-number {
  font-size: 56rpx; font-weight: 700;
  background: linear-gradient(135deg, #f4a3a8, #f7b7a0);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 20rpx;
}
.question-title {
  font-size: 32rpx; font-weight: 600; color: #3a3a3a;
  line-height: 1.5; margin-bottom: 40rpx;
}

/* Options */
.options-list { display: flex; flex-direction: column; gap: 20rpx; }
.option-item {
  display: flex; align-items: center;
  background-color: #fff; border-radius: 16rpx;
  padding: 28rpx 24rpx; border: 3rpx solid transparent;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s;
}
.option-item.selected { border-color: #f4a3a8; background-color: #fef5f6; }
.option-radio {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 3rpx solid #ddd;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx; font-size: 24rpx; color: #bbb;
  flex-shrink: 0; transition: all 0.2s;
}
.option-radio.checked { border-color: #f4a3a8; background-color: #f4a3a8; color: #fff; font-weight: 600; }
.option-text { font-size: 28rpx; color: #666; line-height: 1.5; flex: 1; }

/* Navigation */
.nav-bar {
  display: flex; justify-content: center; gap: 24rpx;
  padding: 30rpx; margin-top: 20rpx;
}
.nav-btn {
  padding: 20rpx 60rpx; border-radius: 44rpx;
  font-size: 28rpx; font-weight: 500; transition: all 0.2s;
}
.nav-btn.prev { background-color: #fff; color: #888; border: 2rpx solid #e8e0d5; }
.nav-btn.next { background-color: #fff; color: #f4a3a8; border: 2rpx solid #f4a3a8; }
.nav-btn.submit {
  background: linear-gradient(135deg, #f4a3a8, #f7b7a0);
  color: #fff; box-shadow: 0 6rpx 20rpx rgba(244, 163, 168, 0.3);
}
.nav-btn.disabled { opacity: 0.35; pointer-events: none; }

/* Consent Dialog */
.privacy-consent { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: center; justify-content: center; }
.consent-card { width: 600rpx; background: #fff; border-radius: 24rpx; padding: 50rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.consent-icon { font-size: 56rpx; margin-bottom: 20rpx; }
.consent-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 24rpx; }
.consent-text { font-size: 26rpx; color: #666; line-height: 1.8; text-align: center; margin-bottom: 40rpx; }
.consent-actions { display: flex; flex-direction: column; width: 100%; gap: 16rpx; }
.consent-btn { width: 100%; height: 80rpx; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.btn-agree { background: linear-gradient(135deg, #f4a3a8, #8fc8b5); color: #fff; }
.btn-back { background: #f5f5f5; color: #999; }

/* Consent Dialog (van-dialog) */
.consent-body { padding: 20rpx; }
.consent-points { margin-bottom: 10rpx; }
.consent-point { font-size: 24rpx; color: #999; line-height: 2; padding-left: 32rpx; position: relative; }
.consent-point::before { content: "●"; position: absolute; left: 0; color: #8fc8b5; font-weight: bold; }

/* 草稿恢复弹窗 */
.restore-body { padding: 30rpx; text-align: center; }
.restore-icon { font-size: 64rpx; margin-bottom: 24rpx; }
.restore-summary { font-size: 28rpx; color: #444; font-weight: 600; margin-bottom: 20rpx; }
.restore-detail { font-size: 24rpx; color: #888; line-height: 2; margin-bottom: 20rpx; }
.restore-time { display: block; color: #aaa; }
.restore-hint { font-size: 22rpx; color: #f4a3a8; margin-top: 10rpx; }
/* ===== 复杂题型样式 ===== */

/* 题型标签 */
.qtype-tag {
  display: inline-block;
  padding: 4rpx 16rpx; border-radius: 20rpx;
  background: #fef0f2; color: #f4a3a8;
  font-size: 20rpx; margin-bottom: 16rpx;
}

/* ===== 多选 ===== */
.multi-hint {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 20rpx; margin-bottom: 16rpx;
  background: #f5f7fa; border-radius: 10rpx;
  font-size: 22rpx; color: #888;
}
.multi-count { color: #f4a3a8; font-weight: 600; }
.multi-option { }
.option-checkbox {
  width: 44rpx; height: 44rpx; border-radius: 8rpx;
  border: 3rpx solid #ddd;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx; flex-shrink: 0; transition: all 0.2s;
}
.option-checkbox.checked {
  border-color: #f4a3a8; background-color: #f4a3a8;
}
.multi-option.selected {
  border-color: #f4a3a8; background-color: #fef5f6;
}

/* ===== 矩阵量表 ===== */
.matrix-section {
  background: #fff; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.matrix-scroll {
  overflow-x: auto;
}
.matrix-header {
  display: flex; align-items: center;
  background: #f5f7fa; border-bottom: 1rpx solid #e8e8e8;
}
.matrix-col-header {
  flex: 1; min-width: 120rpx; text-align: center;
  padding: 16rpx 8rpx; font-size: 20rpx; color: #888;
  border-left: 1rpx solid #f0f0f0;
}
.matrix-row {
  display: flex; align-items: center;
}
.matrix-row + .matrix-row { border-top: 1rpx solid #f0f0f0; }
.matrix-row-label {
  width: 180rpx; flex-shrink: 0;
  padding: 16rpx 12rpx; font-size: 22rpx; color: #555;
  line-height: 1.4;
}
.matrix-col-cell {
  flex: 1; min-width: 120rpx; text-align: center;
  padding: 16rpx 8rpx; border-left: 1rpx solid #f0f0f0;
  display: flex; align-items: center; justify-content: center;
}
.matrix-col-cell.matrix-selected {
  background: #fef5f6;
}
.matrix-radio {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  border: 3rpx solid #ddd;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.matrix-radio.matrix-checked {
  border-color: #f4a3a8; background-color: #f4a3a8;
}

/* ===== 是非题 ===== */
.boolean-section {
  padding: 20rpx 0;
}
.boolean-options {
  display: flex; gap: 30rpx; justify-content: center;
}
.boolean-option {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 200rpx; height: 200rpx; border-radius: 24rpx;
  border: 4rpx solid #e8e0d5; background: #fff;
  transition: all 0.25s;
}
.boolean-option.boolean-yes {
  border-color: #8fc8b5; background: #f0faf5;
}
.boolean-option.boolean-no {
  border-color: #f4a3a8; background: #fef5f6;
}
.boolean-icon {
  font-size: 56rpx; margin-bottom: 12rpx;
}
.boolean-option.boolean-yes .boolean-icon { color: #8fc8b5; }
.boolean-option.boolean-no .boolean-icon { color: #f4a3a8; }
.boolean-text {
  font-size: 30rpx; font-weight: 600;
}
.boolean-option.boolean-yes .boolean-text { color: #609e85; }
.boolean-option.boolean-no .boolean-text { color: #d07a80; }
