<!-- 知情同意弹窗 -->
<van-dialog id="consent-dialog" show="{{!consentGiven && !showRestoreModal}}" show-cancel-button="{{false}}" confirm-button-text="开始测评" bind:confirm="onConsentAgree" close-on-click-overlay="{{false}}">
  <view class="consent-body">
    <view class="consent-icon">🔒</view>
    <view class="consent-title">知情同意书</view>
    <view class="consent-text">本测评结果仅用于心理健康教育和风险筛查参考，不构成医疗诊断。您的个人数据受隐私保护，不会公开给其他学生或用于无关评价。</view>
    <view class="consent-points">
      <view class="consent-point">测评过程中，请根据实际情况诚实作答</view>
      <view class="consent-point">答题进度会自动保存在当前设备，可稍后继续</view>
      <view class="consent-point">测评结果仅您本人可见</view>
      <view class="consent-point">提交后由校内服务保存；网络中断时会保留待同步记录并在恢复后重试</view>
    </view>
  </view>
</van-dialog>

<!-- 草稿恢复弹窗 -->
<van-dialog id="restore-dialog" show="{{showRestoreModal}}" title="恢复答题进度" confirm-button-text="恢复继续" cancel-button-text="重新开始" bind:confirm="restoreDraft" bind:cancel="discardDraft" close-on-click-overlay="{{false}}">
  <view class="restore-body">
    <view class="restore-icon">💾</view>
    <view class="restore-summary">检测到上次未完成的答题记录</view>
    <view class="restore-detail" wx:if="{{draftInfo}}">
      <text>已答：{{draftInfo.answeredCount}} / {{draftInfo.totalCount}} 题</text>
      <text class="restore-time">保存时间：{{draftInfo.savedTime}}</text>
    </view>
    <view class="restore-hint">点击"恢复继续"从上次中断处继续答题</view>
  </view>
</van-dialog>

<!-- 答题内容 -->
<view class="page" wx:if="{{consentGiven}}">
  <view class="progress-header">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%;"></view>
    </view>
    <view class="progress-text">{{currentIndex + 1}}/{{totalQuestions}}</view>
  </view>

  <!-- 自动保存状态提示 -->
  <view class="draft-indicator" wx:if="{{showDraftIndicator}}">
    <view class="draft-dot"></view>
    <text class="draft-text">{{draftSavedText}}</text>
  </view>

  <!-- 题目区域：按题型渲染 -->
  <view class="question-area" wx:for="{{questions}}" wx:key="id" wx:if="{{index === currentIndex}}">
    <view class="question-number">Q{{index + 1}}</view>
    <view class="question-title">{{item.title}}</view>

    <!-- 题型标签 -->
    <view class="qtype-tag" wx:if="{{item.type && item.type !== 'single'}}">
      <text>{{item.type === 'multiple' ? '多选题' : (item.type === 'matrix' ? '矩阵量表' : (item.type === 'boolean' ? '是非题' : ''))}}</text>
    </view>

    <!-- ===== 单选题（默认） ===== -->
    <view class="options-list" wx:if="{{!item.type || item.type === 'single'}}">
      <view wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="optIdx" wx:key="label" class="option-item {{selectedOption === optIdx ? 'selected' : ''}}" data-index="{{optIdx}}" bindtap="onSelectOption">
        <view class="option-radio {{selectedOption === optIdx ? 'checked' : ''}}">
          <text>{{opt.label}}</text>
        </view>
        <text class="option-text">{{opt.text}}</text>
      </view>
    </view>

    <!-- ===== 多选题 ===== -->
    <view class="options-list" wx:if="{{item.type === 'multiple'}}">
      <view class="multi-hint" wx:if="{{item.minSelect || item.maxSelect}}">
        <text>请选择 {{item.minSelect || 1}}~{{item.maxSelect || item.options.length}} 项</text>
        <text class="multi-count">已选：{{multiSelected.length}}</text>
      </view>
      <view wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="optIdx" wx:key="label" class="option-item multi-option {{multiSelected.indexOf(optIdx) >= 0 ? 'selected' : ''}}" data-index="{{optIdx}}" bindtap="onMultiSelect">
        <view class="option-checkbox {{multiSelected.indexOf(optIdx) >= 0 ? 'checked' : ''}}">
          <van-icon wx:if="{{multiSelected.indexOf(optIdx) >= 0}}" name="success" size="16px" color="#fff" />
        </view>
        <text class="option-text">{{opt.text}}</text>
      </view>
    </view>

    <!-- ===== 矩阵量表 ===== -->
    <view class="matrix-section" wx:if="{{item.type === 'matrix'}}">
      <view class="matrix-scroll">
        <view class="matrix-header">
          <view class="matrix-row-label"></view>
          <view class="matrix-col-header" wx:for="{{item.columns}}" wx:key="label" wx:for-item="col">{{col.text}}</view>
        </view>
        <view class="matrix-row" wx:for="{{item.rows}}" wx:key="id" wx:for-item="row">
          <view class="matrix-row-label">{{row.text}}</view>
          <view class="matrix-col-cell {{matrixAnswers[row.id] === colIdx ? 'matrix-selected' : ''}}" wx:for="{{item.columns}}" wx:key="label" wx:for-item="col" wx:for-index="colIdx" data-row-id="{{row.id}}" data-col-idx="{{colIdx}}" bindtap="onMatrixSelect">
            <view class="matrix-radio {{matrixAnswers[row.id] === colIdx ? 'matrix-checked' : ''}}"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 是非题 ===== -->
    <view class="boolean-section" wx:if="{{item.type === 'boolean'}}">
      <view class="boolean-options">
        <view class="boolean-option {{selectedOption === 0 ? 'boolean-yes' : ''}}" data-value="{{0}}" bindtap="onBooleanSelect">
          <view class="boolean-icon">✓</view>
          <text class="boolean-text">是</text>
        </view>
        <view class="boolean-option {{selectedOption === 1 ? 'boolean-no' : ''}}" data-value="{{1}}" bindtap="onBooleanSelect">
          <view class="boolean-icon">✗</view>
          <text class="boolean-text">否</text>
        </view>
      </view>
    </view>
  </view>

  <view class="nav-bar">
    <view class="nav-btn prev {{isFirst ? 'disabled' : ''}}" bindtap="onPrev">
      <text>上一题</text>
    </view>
    <view wx:if="{{!isLast}}" class="nav-btn next" bindtap="onNext">
      <text>下一题</text>
    </view>
    <view wx:if="{{isLast}}" class="nav-btn submit" bindtap="onSubmit">
      <text>提交测评</text>
    </view>
  </view>
</view>
