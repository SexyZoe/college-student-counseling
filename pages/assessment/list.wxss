/* pages/assessment/list.wxss */

.assessment-container {
  min-height: 100vh;
  background-color: #faf7f2;
  padding-bottom: 120rpx;
}

/* 分类标签 - 滑动样式 */
.category-section {
  background-color: #ffffff;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 36rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  background-color: #faf7f2;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.category-item:last-child {
  margin-right: 30rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #f4a3a8, #8fc8b5);
  box-shadow: 0 4rpx 15rpx rgba(91, 155, 213, 0.3);
}

.category-text {
  font-size: 28rpx;
  color: #8a8a8a;
  font-weight: 500;
}

.category-item.active .category-text {
  color: #ffffff;
  font-weight: bold;
}

/* 测评列表 */
.assessment-list {
  padding: 30rpx;
}

.assessment-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.assessment-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.card-badge {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.badge-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.card-title-area {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #4a4a4a;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.card-desc {
  font-size: 26rpx;
  color: #b0b0b0;
  line-height: 1.4;
}

.card-footer {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.card-meta {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-left: 8rpx;
}

.card-arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-text {
  font-size: 40rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* 提示信息 */
.tip-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  margin-top: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-left: 8rpx;
}

/* 空状态 */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
}

.empty-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #faf7f2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #8a8a8a;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #b0b0b0;
}