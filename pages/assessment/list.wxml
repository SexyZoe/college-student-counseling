<!-- pages/assessment/list.wxml -->
<view class="assessment-container">
  <!-- 分类标签 - 可滑动 -->
  <view class="category-section">
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="category-list">
        <view
          class="category-item {{currentCategory === item ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="*this"
          bindtap="onCategoryChange"
          data-category="{{item}}"
        >
          <text class="category-text">{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 测评列表 -->
  <view class="assessment-list" wx:if="{{filteredList.length > 0}}">
    <view
      class="assessment-card"
      wx:for="{{filteredList}}"
      wx:key="id"
      bindtap="onAssessmentTap"
      data-id="{{item.id}}"
    >
      <view class="card-header">
        <view class="card-badge" style="background: linear-gradient(135deg, #f4a3a8, #8fc8b5);">
          <text class="badge-text">{{item.category}}</text>
        </view>
        <view class="card-title-area">
          <text class="card-title">{{item.name}}</text>
          <text class="card-desc">{{item.description}}</text>
        </view>
      </view>
      <view class="card-footer">
        <view class="card-meta">
          <van-icon name="edit" size="12px" color="#999" />
          <text class="meta-text">{{item.questions}}题</text>
        </view>
        <view class="card-meta">
          <van-icon name="clock-o" size="12px" color="#999" />
          <text class="meta-text">{{item.duration}}分钟</text>
        </view>
        <view class="card-meta">
          <van-icon name="friends-o" size="12px" color="#999" />
          <text class="meta-text">{{item.participants}}人参与</text>
        </view>
      </view>
      <view class="card-arrow">
        <text class="arrow-text">›</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-section" wx:else>
    <view class="empty-icon-box">
      <van-icon name="edit" size="40px" color="#999" />
    </view>
    <text class="empty-text">暂无{{currentCategory}}类测评</text>
    <text class="empty-tip">敬请期待更多测评内容</text>
  </view>

  <!-- 提示信息 -->
  <view class="tip-section" wx:if="{{filteredList.length > 0}}">
    <van-icon name="info-o" size="14px" color="#999" />
    <text class="tip-text">测评结果仅供参考，如有需要请咨询专业人士</text>
  </view>
</view>