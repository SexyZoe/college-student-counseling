<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 隐私提示横幅 -->
  <view class="privacy-banner" wx:if="{{showPrivacy}}">
    <van-icon name="info-o" size="16px" color="#f4a3a8" />
    <text class="privacy-text">{{privacyNotice}}</text>
    <van-icon name="cross" size="14px" color="#999" bindtap="onClosePrivacy" />
  </view>

  <!-- 顶部问候 -->
  <view class="header-section">
    <view class="greeting-area">
      <view class="greeting-left">
        <text class="greeting-title">{{isLoggedIn ? '你好，' + userInfo.nickName : '你好，同学'}}</text>
        <text class="greeting-sub">今天心情如何？</text>
      </view>
      <view class="user-avatar" bindtap="{{isLoggedIn ? 'goMine' : 'goLogin'}}">
        <image class="avatar-img" src="{{isLoggedIn ? userInfo.avatarUrl : '/images/articles/article_growth.png'}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-section">
    <swiper class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{4000}}" duration="{{500}}" circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{bannerList}}" wx:key="id" bindtap="onBannerTap" data-id="{{item.id}}">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill" />
        <view class="banner-title">{{item.title}}</view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 学期 + 班级信息卡片 -->
  <block wx:if="{{isLoggedIn && userInfo.studentId}}">
    <view class="info-card">
      <!-- 学期 -->
      <view class="info-row">
        <view class="info-icon" style="background:#8fc8b5"><van-icon name="notes-o" size="18px" color="#fff" /></view>
        <view class="info-body">
          <text class="info-label">当前学期</text>
          <text class="info-value">{{currentSemester ? currentSemester.name : '未配置学期'}}</text>
          <text class="info-extra" wx:if="{{currentSemeter}}">{{currentSemester.startDate + ' ~ ' + currentSemester.endDate + ' · ' + semesterPhaseLabel}}</text>
        </view>
      </view>
      <!-- 班级 -->
      <view class="info-row">
        <view class="info-icon" style="background:#8fc1e0"><van-icon name="label-o" size="18px" color="#fff" /></view>
        <view class="info-body">
          <text class="info-label">班级信息</text>
          <text class="info-value">{{userInfo.grade + ' · ' + userInfo.className}}</text>
          <text class="info-extra">{{userInfo.major}}</text>
        </view>
      </view>
      <!-- 辅导员 -->
      <view class="info-row" wx:if="{{userInfo.counselor}}">
        <view class="info-icon" style="background:#b8a9d4"><van-icon name="friends-o" size="18px" color="#fff" /></view>
        <view class="info-body">
          <text class="info-label">辅导员</text>
          <text class="info-value">{{userInfo.counselor}}</text>
          <text class="info-extra" wx:if="{{userInfo.counselorPhone}}">{{'联系电话：' + userInfo.counselorPhone}}</text>
        </view>
      </view>
    </view>

    <!-- 待完成任务 -->
    <view class="task-section">
      <view class="section-header">
        <text class="section-title">待完成测评</text>
        <text class="task-count-badge">{{pendingAssessmentCount > 0 ? pendingAssessmentCount + '项' : ''}}</text>
      </view>
      <view wx:if="{{pendingTasks.length > 0}}">
        <view class="task-card" wx:for="{{pendingTasks}}" wx:key="id" bindtap="onTaskTap" data-assessment-id="{{item.assessmentId}}" data-task-id="{{item.id}}">
          <view class="task-status-bar" style="background:{{item.status === '进行中' ? '#f4a3a8' : '#8fc8b5'}}"></view>
          <view class="task-body">
            <view class="task-top">
              <text class="task-title">{{item.title}}</text>
              <text class="task-days" wx:if="{{item.daysLeftStr}}">{{item.daysLeftStr}}</text>
            </view>
            <view class="task-meta">
              <text class="task-deadline">{{'截止：' + item.deadline}}</text>
              <text class="task-status-tag" style="color:{{item.status === '进行中' ? '#f4a3a8' : '#8fc8b5'}}">{{item.status || '待完成'}}</text>
            </view>
          </view>
          <van-icon name="arrow" size="16px" color="#ccc" />
        </view>
      </view>
      <view class="empty-state" wx:else>
        <van-icon name="passed" size="40px" color="#8fc8b5" />
        <text class="empty-text">当前没有待完成的测评任务</text>
      </view>
    </view>

    <!-- 最近测评结果 -->
    <view class="result-section" wx:if="{{recentResult}}" bindtap="onRecentResultTap">
      <view class="section-header">
        <text class="section-title">最近测评结果</text>
        <view class="section-more">
          <text class="more-text" wx:if="{{resultHistoryCount > 0}}" catchtap="onViewHistory">{{'共' + resultHistoryCount + '条'}}</text>
          <van-icon name="arrow" size="14px" color="#999" />
        </view>
      </view>
      <view class="result-card">
        <view class="result-left">
          <view class="result-name">{{recentResult.assessmentName}}</view>
          <view class="result-date">{{recentResult.date || recentResult.createdAt}}</view>
        </view>
        <view class="result-right">
          <!-- wellbeing 环形进度：用纯色圆环代替 conic-gradient -->
          <view class="score-ring">
            <view class="ring-progress" style="background:{{recentResultLevelColor}}"></view>
            <view class="ring-center">
              <text class="ring-value">{{recentResultRingPercent}}</text>
              <text class="ring-unit">幸福指数</text>
            </view>
          </view>
          <text class="result-level" style="color:{{recentResultLevelColor}}">{{recentResult.level}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 快捷服务入口 -->
  <view class="quick-entry-section">
    <view class="section-title">核心服务</view>
    <view class="entry-grid">
      <view class="entry-item" wx:for="{{quickEntries}}" wx:key="title" bindtap="onQuickEntryTap" data-path="{{item.path}}">
        <view class="entry-icon-wrapper" style="background-color: {{item.color}};">
          <van-icon name="{{item.icon}}" size="24px" color="#ffffff" />
        </view>
        <text class="entry-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 成长与价值 -->
  <view class="article-section" wx:if="{{civicsArticles.length}}">
    <view class="section-header">
      <text class="section-title">成长与价值</text>
      <view class="section-more" bindtap="onQuickEntryTap" data-path="/pages/civics/index">
        <text class="more-text">更多</text>
        <van-icon name="arrow" size="14px" color="#999" />
      </view>
    </view>
    <view class="civics-mini" wx:for="{{civicsArticles}}" wx:key="id" data-id="{{item.id}}" bindtap="onCivicsTap">
      <view>
        <text class="civics-mini-tag">{{item.category}}</text>
        <text class="civics-mini-title">{{item.title}}</text>
        <text class="civics-mini-summary">{{item.summary}}</text>
      </view>
      <van-icon name="arrow" size="16px" color="#bbb" />
    </view>
  </view>

  <!-- 心理资讯 -->
  <view class="article-section">
    <view class="section-header">
      <text class="section-title">每日心理资讯</text>
      <view class="section-more" bindtap="onQuickEntryTap" data-path="/pages/article/list">
        <text class="more-text">更多</text>
        <van-icon name="arrow" size="14px" color="#999" />
      </view>
    </view>
    <view class="article-list">
      <view class="article-card" wx:for="{{articles}}" wx:key="id" bindtap="onArticleTap" data-id="{{item.id}}">
        <image class="article-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="article-content">
          <view class="article-tag">{{item.category}}</view>
          <text class="article-title">{{item.title}}</text>
          <text class="article-summary">{{item.summary}}</text>
          <view class="article-meta">
            <van-icon name="eye-o" size="14px" color="#999" />
            <text class="meta-text">{{item.views + ' 阅读'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>
