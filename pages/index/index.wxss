/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background-color: #faf7f2;
  padding-bottom: 120rpx;
}

/* 隐私横幅 */
.privacy-banner {
  display: flex; align-items: flex-start; gap: 10rpx;
  padding: 18rpx 24rpx; color: #8a6d70; background: #fef0f2;
  font-size: 22rpx; line-height: 1.6;
}
.privacy-text { flex: 1; }

/* ========== 顶部问候 ========== */
.header-section {
  background: linear-gradient(135deg, #f4a3a8 0%, #8fc8b5 100%);
  padding: 30rpx 30rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.greeting-area {
  display: flex; justify-content: space-between; align-items: center;
}
.greeting-left { display: flex; flex-direction: column; }
.greeting-title {
  font-size: 36rpx; font-weight: bold; color: #ffffff; margin-bottom: 8rpx;
}
.greeting-sub { font-size: 26rpx; color: rgba(255, 255, 255, 0.8); }
.user-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5); overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; }

/* ========== 轮播图 ========== */
.banner-section {
  margin: -20rpx 30rpx 30rpx; border-radius: 20rpx; overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(91, 155, 213, 0.2);
}
.banner-swiper { height: 320rpx; }
.banner-image { width: 100%; height: 100%; }
.banner-title {
  position: absolute; bottom: 30rpx; left: 30rpx; right: 30rpx;
  font-size: 28rpx; color: #ffffff; font-weight: 500;
  background: rgba(0, 0, 0, 0.3); padding: 10rpx 20rpx; border-radius: 10rpx;
}

/* ========== 学期 / 班级 / 辅导员信息卡 ========== */
.info-card {
  margin: 0 30rpx 30rpx; padding: 24rpx; border-radius: 20rpx;
  background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
}
.info-row {
  display: flex; align-items: flex-start; padding: 14rpx 0;
}
.info-row:first-child { padding-top: 0; }
.info-row:last-child { padding-bottom: 0; }
.info-row + .info-row { border-top: 1rpx solid #f0ebe0; }
.info-icon {
  width: 52rpx; height: 52rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 18rpx; margin-top: 4rpx;
}
.info-body { flex: 1; display: flex; flex-direction: column; }
.info-label { font-size: 22rpx; color: #aaa; margin-bottom: 4rpx; }
.info-value { font-size: 28rpx; color: #444; font-weight: 600; }
.info-extra { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* ========== 待完成测评 ========== */
.task-section {
  margin: 0 30rpx 30rpx; padding: 30rpx; border-radius: 20rpx;
  background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
}
.task-count-badge { font-size: 24rpx; color: #f4a3a8; font-weight: 600; }
.task-card {
  display: flex; align-items: center; padding: 20rpx 0;
}
.task-card + .task-card { border-top: 1rpx solid #f5f0e8; }
.task-status-bar {
  width: 6rpx; height: 68rpx; border-radius: 3rpx; flex-shrink: 0; margin-right: 18rpx;
}
.task-body { flex: 1; display: flex; flex-direction: column; }
.task-top { display: flex; justify-content: space-between; align-items: center; }
.task-title { font-size: 28rpx; color: #444; font-weight: 600; flex: 1; }
.task-days { font-size: 22rpx; color: #f4a3a8; margin-left: 12rpx; white-space: nowrap; }
.task-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.task-deadline { font-size: 22rpx; color: #999; }
.task-status-tag { font-size: 22rpx; font-weight: 500; }
.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 40rpx 0;
}
.empty-text { font-size: 24rpx; color: #aaa; margin-top: 16rpx; }

/* ========== 最近测评结果 ========== */
.result-section {
  margin: 0 30rpx 30rpx; padding: 30rpx; border-radius: 20rpx;
  background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
}
.result-card {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0 0;
}
.result-left { flex: 1; }
.result-name { font-size: 28rpx; color: #444; font-weight: 600; }
.result-date { font-size: 22rpx; color: #aaa; margin-top: 6rpx; }
.result-right {
  display: flex; flex-direction: column; align-items: center;
}
/* 兼容的纯色圆环（不用 conic-gradient） */
.score-ring {
  position: relative; width: 100rpx; height: 100rpx;
  border-radius: 50%; border: 8rpx solid #e8e8e8; margin-bottom: 6rpx;
}
.ring-progress {
  position: absolute; top: -8rpx; left: -8rpx; right: -8rpx; bottom: -8rpx;
  border-radius: 50%; opacity: 0.25;
}
.ring-center {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-value { font-size: 26rpx; color: #444; font-weight: bold; line-height: 1.1; }
.ring-unit { font-size: 16rpx; color: #aaa; }
.result-level { font-size: 24rpx; font-weight: 600; margin-top: 4rpx; }

/* ========== 快捷入口 ========== */
.quick-entry-section {
  margin: 0 30rpx 30rpx; padding: 30rpx; border-radius: 20rpx;
  background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
}
.section-title {
  font-size: 32rpx; font-weight: bold; color: #4a4a4a; margin-bottom: 20rpx;
}
.section-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;
}
.section-header .section-title { margin-bottom: 0; }
.section-more { display: flex; align-items: center; }
.more-text { font-size: 26rpx; color: #b0b0b0; margin-right: 4rpx; }
.entry-grid { display: flex; flex-wrap: wrap; justify-content: flex-start; }
.entry-item {
  display: flex; flex-direction: column; align-items: center;
  width: 33.333%; margin-bottom: 24rpx;
}
.entry-icon-wrapper {
  width: 90rpx; height: 90rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 16rpx; box-shadow: 0 4rpx 15rpx rgba(0,0,0,.1);
}
.entry-title { font-size: 26rpx; color: #8a8a8a; }

/* ========== 内容区 ========== */
.article-section {
  margin: 0 30rpx 30rpx; padding: 30rpx; border-radius: 20rpx;
  background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
}

/* civics mini */
.civics-mini {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid #f0ebe0;
}
.civics-mini:last-child { border-bottom: 0; }
.civics-mini-tag {
  display: inline-block; color: #79679a; background: #f2eef8;
  border-radius: 6rpx; padding: 2rpx 10rpx; font-size: 20rpx;
}
.civics-mini-title {
  display: block; margin: 8rpx 0 4rpx; color: #444;
  font-size: 28rpx; font-weight: 600;
}
.civics-mini-summary {
  display: block; max-width: 560rpx; color: #999; font-size: 23rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 文章 */
.article-list { display: flex; flex-direction: column; }
.article-card {
  display: flex; padding: 20rpx 0; border-bottom: 1rpx solid #f0ebe0;
}
.article-card:last-child { border-bottom: none; }
.article-cover {
  width: 180rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx;
}
.article-content { flex: 1; display: flex; flex-direction: column; }
.article-tag {
  display: inline-block; padding: 4rpx 12rpx; border-radius: 6rpx;
  font-size: 22rpx; margin-bottom: 10rpx;
  background-color: rgba(91, 155, 213, 0.1); color: #f4a3a8;
}
.article-title {
  font-size: 30rpx; font-weight: bold; color: #4a4a4a; margin-bottom: 8rpx;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}
.article-summary {
  font-size: 24rpx; color: #b0b0b0;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  margin-bottom: 10rpx;
}
.article-meta { display: flex; align-items: center; }
.meta-text { font-size: 22rpx; color: #b0b0b0; margin-left: 6rpx; }

.bottom-safe { height: 120rpx; }
