/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background-color: #faf7f2;
  padding-bottom: 120rpx;
}
.privacy-banner { display:flex; align-items:flex-start; gap:10rpx; padding:18rpx 24rpx; color:#8a6d70; background:#fef0f2; font-size:22rpx; line-height:1.6; }.privacy-text { flex:1; }

/* 顶部问候区域 */
.header-section {
  background: linear-gradient(135deg, #f4a3a8 0%, #8fc8b5 100%);
  padding: 30rpx 30rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.greeting-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.greeting-left { display:flex; flex-direction:column; }.class-info { margin-top:24rpx; padding:18rpx 20rpx; border-radius:16rpx; background:rgba(255,255,255,.16); }.class-info-item { display:flex; align-items:center; gap:10rpx; color:rgba(255,255,255,.92); font-size:23rpx; margin:6rpx 0; }

.greeting-text {
  display: flex;
  flex-direction: column;
}

.greeting-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.greeting-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

/* 轮播图区域 */
.banner-section {
  margin: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(91, 155, 213, 0.2);
}

.banner-swiper {
  height: 320rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
  background: rgba(0, 0, 0, 0.3);
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}

/* 快捷入口 */
.quick-entry-section {
  background-color: #ffffff;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a4a4a;
  margin-bottom: 20rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.333%;
  margin-bottom: 24rpx;
}

.entry-icon-wrapper {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.entry-title {
  font-size: 26rpx;
  color: #8a8a8a;
}

.task-section { margin:30rpx; padding:30rpx; border-radius:20rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(0,0,0,.05); }
.semester-text { font-size:21rpx; color:#aaa; }
.task-card { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #f0ebe0; }
.task-main { flex:1; display:flex; flex-direction:column; }.task-title { color:#444; font-size:27rpx; font-weight:600; }.task-deadline { color:#999; font-size:22rpx; margin-top:6rpx; }.task-action { color:#fff; font-size:23rpx; padding:10rpx 18rpx; border-radius:24rpx; background:#f4a3a8; }
.recent-result { display:flex; justify-content:space-between; padding-top:20rpx; color:#777; font-size:24rpx; }.recent-level { color:#d19a47; }.empty-task { color:#aaa; text-align:center; padding:20rpx 0; font-size:24rpx; }
.civics-mini { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #f0ebe0; }.civics-mini:last-child { border-bottom:0; }.civics-mini-tag { display:inline-block; color:#79679a; background:#f2eef8; border-radius:6rpx; padding:2rpx 10rpx; font-size:20rpx; }.civics-mini-title { display:block; margin:8rpx 0 4rpx; color:#444; font-size:28rpx; font-weight:600; }.civics-mini-summary { display:block; max-width:560rpx; color:#999; font-size:23rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* 推荐文章 */
.article-section {
  background-color: #ffffff;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-more {
  display: flex;
  align-items: center;
}

.more-text {
  font-size: 26rpx;
  color: #b0b0b0;
  margin-left: 6rpx;
}

.article-list {
  display: flex;
  flex-direction: column;
}

.article-card {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0ebe0;
}

.article-card:last-child {
  border-bottom: none;
}

.article-cover {
  width: 180rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.article-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.article-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-bottom: 10rpx;
  background-color: rgba(91, 155, 213, 0.1);
  color: #f4a3a8;
}

.article-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4a4a4a;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-summary {
  font-size: 24rpx;
  color: #b0b0b0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.article-meta {
  display: flex;
  align-items: center;
}

.meta-text {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-left: 6rpx;
}
