/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4a3a8 0%, #8fc8b5 60%, #faf7f2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 卡片容器 */
.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.08);
}

/* Logo */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}
.logo-image {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #f4a3a8;
  margin-bottom: 24rpx;
}
.logo-title {
  font-size: 36rpx; font-weight: bold; color: #333;
}
.logo-subtitle {
  font-size: 24rpx; color: #999; margin-top: 8rpx;
}

.role-tabs { display: flex; padding: 8rpx; margin-bottom: 16rpx; border-radius: 18rpx; background: #f7f2ea; }
.role-tab { flex: 1; padding: 16rpx 8rpx; text-align: center; color: #8a8a8a; font-size: 26rpx; border-radius: 14rpx; }
.role-tab.active { color: #fff; font-weight: 600; background: linear-gradient(135deg,#f4a3a8,#8fc8b5); box-shadow: 0 4rpx 12rpx rgba(0,0,0,.08); }
.role-description { margin-bottom: 32rpx; color: #888; font-size: 23rpx; line-height: 1.5; text-align: center; }

/* 输入框 */
.input-group { margin-bottom: 30rpx; }
.input-label {
  font-size: 26rpx; color: #666; margin-bottom: 12rpx; font-weight: 500;
}
.input-wrapper {
  display: flex; align-items: center;
  background: #f7f7f7; border-radius: 16rpx; padding: 0 24rpx;
  border: 2rpx solid #eee;
}
.login-input {
  flex: 1; height: 88rpx; font-size: 28rpx;
  margin-left: 16rpx; background: transparent;
}
.password-toggle { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 72rpx; }

/* 错误提示 */
.error-msg {
  color: #c84343; font-size: 24rpx; margin: 20rpx 0; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff1f1; line-height: 1.5; text-align: left;
}

/* 登录按钮 */
.login-btn {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #f4a3a8, #8fc8b5);
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #fff; font-weight: 500;
  margin-top: 10rpx;
}
.login-btn.loading { opacity: 0.6; }
.forgot-password { margin:22rpx 0 16rpx; color:#4f8f7c; font-size:25rpx; text-align:center; }

/* 隐私政策 */
.agreement-section {
  margin: 18rpx 0 4rpx; display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
}
.agreement-text { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.agreement-link { font-size: 24rpx; color: #f4a3a8; }
.security-note { margin-top:28rpx; padding:20rpx; border-radius:14rpx; background:#f8f8f8; color:#777; font-size:22rpx; line-height:1.6; }

/* 第2步 */
.bind-info {
  background: #f9f5f0; border-radius: 16rpx; padding: 30rpx; margin-bottom: 40rpx;
}
.bind-hint { font-size: 26rpx; color: #666; line-height: 1.6; }

.wechat-btn {
  width: 100%; height: 88rpx;
  background: #07C160; border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 32rpx; color: #fff; font-weight: 500;
  box-shadow: 0 8rpx 30rpx rgba(7,193,96,0.25);
}
.wechat-btn.loading { opacity: 0.6; }

.skip-section {
  margin-top: 40rpx; text-align: center; padding: 20rpx;
}
.skip-text { font-size: 26rpx; color: #999; }

.back-section {
  display: flex; align-items: center; justify-content: center;
  margin-top: 20rpx; padding: 20rpx;
}
.back-text-small { font-size: 24rpx; color: #999; margin-left: 6rpx; }

/* 完成状态 */
.done-icon { text-align: center; font-size: 64rpx; margin-bottom: 30rpx; }
.done-text { text-align: center; font-size: 30rpx; color: #666; }
