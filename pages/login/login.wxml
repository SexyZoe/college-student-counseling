<view class="login-container">
  <view class="login-card" wx:if="{{step === 'login'}}">
    <view class="logo-section">
      <image class="logo-image" src="/images/logo.png" mode="aspectFill" />
      <text class="logo-title">数智心港湾</text>
      <text class="logo-subtitle">大学生心理健康支持平台</text>
    </view>

    <view class="role-tabs">
      <view wx:for="{{roleOptions}}" wx:key="value" class="role-tab {{role === item.value ? 'active' : ''}}" data-role="{{item.value}}" bindtap="onRoleTap">{{item.label}}</view>
    </view>
    <view class="role-description">{{roleDescription}}</view>

    <view class="input-group">
      <view class="input-label">{{accountLabel}}</view>
      <view class="input-wrapper">
        <van-icon name="user-o" size="18px" color="#999" />
        <input class="login-input" type="text" placeholder="{{accountPlaceholder}}" value="{{accountId}}" bindinput="onAccountInput" maxlength="32" disabled="{{loading}}" confirm-type="next" />
      </view>
    </view>
    <view class="input-group">
      <view class="input-label">独立密码</view>
      <view class="input-wrapper">
        <van-icon name="lock" size="18px" color="#999" />
        <input class="login-input" type="text" password="{{!showPassword}}" placeholder="请输入本系统独立密码" value="{{password}}" bindinput="onPasswordInput" bindconfirm="onLogin" maxlength="64" disabled="{{loading}}" confirm-type="done" />
        <view class="password-toggle" bindtap="togglePassword" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}">
          <van-icon name="{{showPassword ? 'eye-o' : 'closed-eye'}}" size="18px" color="#999" />
        </view>
      </view>
    </view>

    <view class="agreement-section">
      <van-checkbox value="{{agreed}}" bind:change="onAgreementChange" shape="square" icon-size="14px" />
      <text class="agreement-text">我已阅读并同意</text>
      <text class="agreement-link" bindtap="viewAgreement">《隐私政策与敏感信息说明》</text>
    </view>

    <view class="error-msg" wx:if="{{loginError}}" role="alert">{{loginError}}</view>
    <view class="login-btn {{loading ? 'loading' : ''}}" bindtap="onLogin">{{loading ? '验证中…' : '登录'}}</view>
    <view class="forgot-password" wx:if="{{role === 'student'}}" bindtap="showPasswordRecovery">忘记密码？</view>
    <view class="role-description" wx:if="{{role === 'student'}}">名单导入账号使用学号登录，初始密码为学号后4位。首次登录必须修改密码。</view>
    <view class="role-description" wx:if="{{role === 'counselor'}}">辅导员账号由管理员创建，请使用管理员发放的临时密码登录；首次登录必须修改密码。</view>
    <view class="security-note">连续输错 5 次将临时锁定账号。若无法连接服务，请确认手机已连接校园网。</view>
  </view>

  <view class="login-card" wx:if="{{step === 'bind'}}">
    <view class="logo-section">
      <image class="logo-image" src="/images/logo.png" mode="aspectFill" />
      <text class="logo-title">绑定微信身份</text>
      <text class="logo-subtitle">校内身份验证成功</text>
    </view>
    <view class="bind-info"><text class="bind-hint">微信资料仅用于识别当前账号；不绑定也可以继续使用学号账号。</text></view>
    <view class="error-msg" wx:if="{{bindError}}" role="alert">{{bindError}}</view>
    <view class="wechat-btn {{loading ? 'loading' : ''}}" bindtap="onBindWechat">
      <van-icon name="wechat" size="20px" color="#ffffff" />
      <text>{{loading ? '绑定中...' : '微信一键绑定'}}</text>
    </view>
    <view class="skip-section" bindtap="onSkipBind"><text class="skip-text">暂不绑定，继续使用</text></view>
    <view class="back-section" bindtap="goBack"><van-icon name="arrow-left" size="14px" color="#999" /><text class="back-text-small">返回重新登录</text></view>
  </view>

  <view class="login-card" wx:if="{{step === 'done'}}">
    <view class="done-icon">✓</view>
    <text class="done-text">登录成功，正在进入对应工作台…</text>
  </view>
</view>
