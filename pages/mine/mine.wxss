/* pages/mine/mine.wxss */

.mine-container {
  min-height: 100vh;
  background-color: #faf7f2;
  padding-bottom: 120rpx;
}

/* 用户信息区域 */
.user-section {
  background: linear-gradient(135deg, #f4a3a8 0%, #8fc8b5 100%);
  padding: 60rpx 30rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.user-header { display:flex; align-items:center; margin-bottom:26rpx; }.avatar-btn { width:108rpx; height:108rpx; padding:0; margin:0; border:0; border-radius:50%; background:transparent; overflow:hidden; }.avatar-btn::after { border:0; }.edit-btn { display:flex; align-items:center; gap:6rpx; color:rgba(255,255,255,.8); font-size:23rpx; }
.edit-profile-popup { padding:30rpx; background:#fff; }.edit-profile-header { display:flex; align-items:center; justify-content:space-between; padding-bottom:22rpx; border-bottom:1rpx solid #eee; }.edit-profile-title { font-size:32rpx; font-weight:700; }.edit-field { margin-top:24rpx; }.edit-label { display:block; color:#666; font-size:25rpx; margin-bottom:10rpx; }.grade-select { display:flex; flex-wrap:wrap; gap:12rpx; }.grade-item { padding:10rpx 20rpx; border-radius:22rpx; color:#777; background:#f6f6f6; font-size:23rpx; }.grade-item.active { color:#fff; background:#8fc8b5; }.edit-profile-footer { padding-top:28rpx; }.save-btn { padding:20rpx; text-align:center; color:#fff; border-radius:36rpx; background:linear-gradient(135deg,#f4a3a8,#8fc8b5); }

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.user-detail {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 学籍信息区域 */
.student-info-row {
  display: flex; flex-wrap: wrap;
  padding: 20rpx 30rpx 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}
.info-item {
  width: 45%; display: flex; align-items: center;
  padding: 8rpx 0;
}
.info-label { font-size: 22rpx; color: rgba(255,255,255,0.6); width: 90rpx; }
.info-value { font-size: 22rpx; color: rgba(255,255,255,0.9); }

/* 功能菜单 */
.menu-section {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0ebe0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #4a4a4a;
  margin-left: 20rpx;
}

/* 其他信息 */
.info-section {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.info-card {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0ebe0;
}

.info-card:last-child {
  border-bottom: none;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-text {
  flex: 1;
  font-size: 30rpx;
  color: #4a4a4a;
  margin-left: 20rpx;
}

/* 退出登录 */
.logout-section {
  margin: 30rpx;
}

.logout-btn {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.logout-text {
  font-size: 30rpx;
  color: #e87d7d;
}

/* 版本信息 */
.version-section {
  margin-top: 60rpx;
  text-align: center;
}

.version-text {
  font-size: 24rpx;
  color: #b0b0b0;
}
/* 未登录状态 */
.user-section.unlogged { cursor: pointer; }
.unlogged-content {
  display: flex;
  align-items: center;
  cursor: pointer;
}
.unlogged-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255,255,255,0.5);
}
.unlogged-text {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}
.unlogged-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}
.unlogged-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}
