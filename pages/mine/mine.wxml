<!-- pages/mine/mine.wxml -->
<view class="mine-container">
  <!-- 已登录：个人信息卡片 -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    <view class="user-header">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
      </button>
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickName || '同学'}}</text>
        <text class="user-desc">
          {{userInfo.studentName || ''}}{{userInfo.studentId ? ' ' + userInfo.studentId : ''}}
        </text>
      </view>
      <view class="edit-btn" bindtap="onEditProfile">
        <van-icon name="edit" size="16px" color="rgba(255,255,255,0.7)"/>
        <text>编辑</text>
      </view>
    </view>
    <!-- 学籍信息区域 -->
    <view class="student-info-row" wx:if="{{userInfo.studentId}}">
      <view class="info-item">
        <text class="info-label">学号</text>
        <text class="info-value">{{userInfo.studentId}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">年级</text>
        <text class="info-value">{{userInfo.grade || '-'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">专业</text>
        <text class="info-value">{{userInfo.major || '-'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">班级</text>
        <text class="info-value">{{userInfo.className || '-'}}</text>
      </view>
      <view class="info-item" wx:if="{{userInfo.counselor}}">
        <text class="info-label">辅导员</text>
        <text class="info-value">{{userInfo.counselor}}</text>
      </view>
    </view>
  </view>

  <!-- 未登录 -->
  <view class="user-section unlogged" wx:else>
    <view class="unlogged-content" bindtap="goLogin">
      <view class="unlogged-avatar">
        <van-icon name="user-o" size="40px" color="#ffffff"/>
      </view>
      <view class="unlogged-text">
        <text class="unlogged-title">点击登录</text>
        <text class="unlogged-sub">使用学号登录可查看班级与辅导员信息</text>
      </view>
      <van-icon name="arrow" size="18px" color="rgba(255,255,255,0.7)"/>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-section">
    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuItems}}" wx:key="title" bindtap="onMenuTap" data-path="{{item.path}}" data-is-modal="{{item.isModal}}">
        <view class="menu-icon-wrapper" style="background-color: {{item.color}};">
          <van-icon name="{{item.icon}}" size="20px" color="#ffffff"/>
        </view>
        <text class="menu-title">{{item.title}}</text>
        <van-icon name="arrow" size="16px" color="#b0b0b0"/>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <view class="logout-btn" bindtap="onLogout">
      <text class="logout-text">退出登录</text>
    </view>
  </view>

  <view class="version-section">
    <text class="version-text">数智心港湾 v2.0.0 · 本地演示</text>
  </view>

  <!-- 编辑个人资料弹窗 -->
  <van-popup show="{{showEditPopup}}" position="bottom" bind:close="onCloseEditPopup" round custom-style="max-height: 80vh; overflow-y:auto;">
    <view class="edit-profile-popup">
      <view class="edit-profile-header">
        <text class="edit-profile-title">编辑个人资料</text>
        <view class="edit-profile-close" bindtap="onCloseEditPopup">
          <van-icon name="cross" size="20px" color="#999"/>
        </view>
      </view>
      <view class="edit-profile-body">
        <view class="edit-field">
          <text class="edit-label">昵称</text>
          <van-field value="{{editNickName}}" placeholder="请输入昵称" bind:change="onNickNameInput"/>
        </view>
        <view class="edit-field">
          <text class="edit-label">学号</text>
          <van-field value="{{editStudentId}}" placeholder="请输入学号" bind:change="onStudentIdInput" disabled="{{true}}"/>
        </view>
        <view class="edit-field">
          <text class="edit-label">年级</text>
          <view class="grade-select">
            <view class="grade-item {{editGrade === item ? 'active' : ''}}" wx:for="{{grades}}" wx:key="*this" bindtap="onGradeSelect" data-index="{{index}}">
              <text>{{item}}</text>
            </view>
          </view>
        </view>
        <view class="edit-field">
          <text class="edit-label">专业</text>
          <van-field value="{{editMajor}}" placeholder="请输入专业" bind:change="onMajorInput"/>
        </view>
        <view class="edit-field">
          <text class="edit-label">班级</text>
          <van-field value="{{editClassName}}" placeholder="请输入班级" bind:change="onClassNameInput"/>
        </view>
      </view>
      <view class="edit-profile-footer">
        <view class="save-btn" bindtap="onSaveProfile">
          <text class="save-text">保存</text>
        </view>
      </view>
    </view>
  </van-popup>
</view>
