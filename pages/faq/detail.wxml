<view class="faq-detail" wx:if="{{item}}">
  <view class="detail-header">
    <view class="detail-back" bindtap="onBack">
      <van-icon name="arrow-left" size="18px" color="#666" />
      <text>返回</text>
    </view>
    <view class="detail-cat">{{item.category}}</view>
    <text class="detail-question">{{item.question}}</text>
  </view>
  <view class="detail-body">
    <text class="detail-answer">{{item.answer}}</text>
  </view>
  <view class="detail-tags">
    <text class="tag-item" wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text>
  </view>
  <view class="detail-disclaimer">以上内容仅供参考，不构成医疗诊断或专业心理咨询建议。如有严重心理困扰，请及时寻求专业帮助。</view>
</view>
