.detail-page { min-height:100vh; padding-bottom:50rpx; background:#faf7f2; }.detail-head { padding:42rpx 34rpx; background:#fff; }.detail-tag { display:inline-block; padding:5rpx 14rpx; color:#79679a; background:#f2eef8; border-radius:8rpx; font-size:22rpx; }.detail-title { display:block; margin:18rpx 0 12rpx; font-size:40rpx; color:#2f2f2f; font-weight:700; line-height:1.45; }.detail-summary { display:block; color:#777; font-size:26rpx; line-height:1.7; }.detail-meta { display:flex; flex-wrap:wrap; gap:20rpx; margin-top:22rpx; color:#aaa; font-size:22rpx; }.detail-content { margin:24rpx 30rpx; padding:34rpx; background:#fff; border-radius:20rpx; font-size:28rpx; color:#4d4d4d; line-height:2; white-space:pre-wrap; }.detail-note { margin:20rpx 30rpx; padding:22rpx; color:#887b96; background:#f2eef8; border-radius:16rpx; font-size:23rpx; line-height:1.7; }.share-btn { margin:30rpx; color:#fff; background:linear-gradient(135deg,#b8a9d4,#8fc1e0); border-radius:40rpx; font-size:27rpx; }
