<view class="detail-page" wx:if="{{article.id}}">
  <view class="detail-head"><view class="detail-tag">{{article.category}}</view><text class="detail-title">{{article.title}}</text><text class="detail-summary">{{article.summary}}</text><view class="detail-meta"><text>发布：{{article.author}}</text><text>审核：{{article.reviewer}}</text><text>{{article.publishTime}}</text></view></view>
  <view class="detail-content"><text user-select>{{article.content}}</text></view>
  <view class="detail-media" wx:if="{{article.media.length}}">
    <block wx:for="{{article.media}}" wx:key="id">
      <image wx:if="{{item.kind === 'image'}}" class="article-media" src="{{item.url}}" mode="widthFix" show-menu-by-longpress />
      <video wx:else class="article-video" src="{{item.url}}" controls object-fit="contain" />
    </block>
  </view>
  <view class="detail-note">欢迎理性交流。内容关注价值教育与社会责任，不用于判断学生心理健康状况。</view>
  <button class="share-btn" open-type="share">分享内容</button>
</view>
