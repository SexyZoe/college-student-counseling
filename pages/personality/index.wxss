.personality-page { min-height: 100vh; background: #faf7f2; }
.page-banner { display: flex; flex-direction: column; align-items: center; padding: 50rpx 30rpx 30rpx; background: linear-gradient(135deg, #f4a3a8, #8fc8b5, #8fc1e0); }
.banner-emoji { font-size: 60rpx; margin-bottom: 16rpx; }
.banner-title { font-size: 36rpx; font-weight: bold; color: #fff; }
.banner-sub { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; }
.disclaimer-box { display: flex; align-items: flex-start; gap: 8rpx; margin: 20rpx 30rpx; padding: 20rpx; background: #fff; border-radius: 12rpx; font-size: 22rpx; color: #999; line-height: 1.6; }
.test-list { padding: 10rpx 30rpx; }
.test-card { display: flex; align-items: center; padding: 30rpx; margin-bottom: 20rpx; background: #fff; border-radius: 20rpx; }
.test-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-right: 24rpx; }
.test-info { flex: 1; }
.test-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 6rpx; display: block; }
.test-desc { font-size: 24rpx; color: #999; margin-bottom: 8rpx; display: block; }
.test-meta { font-size: 22rpx; color: #bbb; display: flex; gap: 8rpx; }