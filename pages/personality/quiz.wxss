.quiz-container { min-height: 100vh; background: #faf7f2; padding: 30rpx; }
.quiz-progress { display: flex; align-items: center; gap: 16rpx; margin-bottom: 40rpx; }
.progress-bar { flex: 1; height: 8rpx; background: #eee; border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #f4a3a8, #8fc8b5); border-radius: 4rpx; transition: width 0.3s; }
.progress-text { font-size: 26rpx; color: #999; min-width: 80rpx; text-align: right; }
.quiz-card { background: #fff; border-radius: 24rpx; padding: 40rpx 30rpx; }
.quiz-question { font-size: 34rpx; font-weight: bold; color: #333; line-height: 1.6; margin-bottom: 40rpx; display: block; }
.quiz-options { display: flex; flex-direction: column; gap: 20rpx; }
.quiz-option { display: flex; align-items: center; padding: 24rpx 20rpx; border-radius: 16rpx; border: 2rpx solid #eee; background: #fafafa; }
.quiz-option.selected { border-color:#b8a9d4; background:#f2eef8; }
.option-label { width: 48rpx; height: 48rpx; border-radius: 50%; background: linear-gradient(135deg, #f4a3a8, #8fc8b5); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: bold; margin-right: 20rpx; flex-shrink: 0; }
.option-text { font-size: 28rpx; color: #555; flex: 1; }
.quiz-back { display: flex; align-items: center; justify-content: center; padding: 30rpx; gap: 8rpx; }
.quiz-note { margin-top:24rpx; color:#aaa; font-size:22rpx; text-align:center; line-height:1.7; }
