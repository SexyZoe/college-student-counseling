<view class="quiz-container">
  <view class="quiz-progress">
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{(currentIndex/questions.length)*100}}%"></view>
    </view>
    <text class="progress-text">{{currentIndex+1}}/{{questions.length}}</text>
  </view>

  <view class="quiz-card" wx:if="{{questions[currentIndex]}}">
    <text class="quiz-question">{{questions[currentIndex].title}}</text>
    <view class="quiz-options">
      <view class="quiz-option {{selectedOption === index ? 'selected' : ''}}" wx:for="{{questions[currentIndex].options}}" wx:key="label" bindtap="selectOption" data-option="{{index}}">
        <view class="option-label">{{item.label}}</view>
        <text class="option-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="quiz-note">本探索不用于心理健康评分，也不会向辅导员展示个人结果。</view>
  <view class="quiz-back" bindtap="goBack">
    <van-icon name="arrow-left" size="16px" color="#999" />
    <text>上一题</text>
  </view>
</view>
