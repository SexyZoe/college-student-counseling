.result-page { min-height: 100vh; background: #faf7f2; padding-bottom: 40rpx; }
.result-hero { display: flex; flex-direction: column; align-items: center; padding: 60rpx 30rpx 50rpx; }
.result-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.result-name { font-size: 40rpx; font-weight: bold; color: #fff; margin-bottom: 16rpx; }
.result-title { color:rgba(255,255,255,.88); font-size:27rpx; margin-bottom:16rpx; }
.result-desc { font-size: 26rpx; color: rgba(255,255,255,0.9); text-align: center; line-height: 1.7; }
.result-section { margin: 20rpx 30rpx; padding: 30rpx; background: #fff; border-radius: 20rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; display: block; }
.strength-item { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 14rpx; font-size: 26rpx; color: #555; line-height: 1.6; }
.strength-dot { margin-top: 4rpx; }
.result-disclaimer { margin: 20rpx 30rpx; text-align: center; font-size: 22rpx; color: #ccc; padding: 20rpx; }
.result-actions { display: flex; justify-content: center; margin-top: 20rpx; }
.retry-btn { padding: 20rpx 60rpx; background: linear-gradient(135deg, #f4a3a8, #8fc8b5); color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.type-code { display:block; font-size:68rpx; font-weight:800; text-align:center; letter-spacing:10rpx; }.type-note,.career-text { display:block; color:#777; font-size:25rpx; line-height:1.7; text-align:center; }.career-text { text-align:left; }
