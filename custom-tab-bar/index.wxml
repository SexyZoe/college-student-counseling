<cover-view class="tab-bar">
  <cover-view wx:for="{{list}}" wx:key="pagePath" class="tab-bar-item" data-index="{{index}}" bindtap="switchTab">
    <cover-view class="tab-icon {{selected === index ? 'active' : ''}}">{{index === 0 ? '⌂' : (index === 1 ? '✓' : '○')}}</cover-view>
    <cover-view class="tab-bar-text" style="color: {{selected === index ? '#e88a8f' : '#8a8a8a'}}">{{item.text}}</cover-view>
  </cover-view>
</cover-view>
