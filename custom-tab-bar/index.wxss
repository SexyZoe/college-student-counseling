.tab-bar { position: fixed; left: 0; right: 0; bottom: 0; height: 100rpx; padding-bottom: env(safe-area-inset-bottom); display: flex; background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,.06); z-index: 999; }
.tab-bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tab-icon { width: 38rpx; height: 38rpx; line-height: 38rpx; text-align: center; border-radius: 50%; color: #8a8a8a; font-size: 30rpx; }
.tab-icon.active { color: #fff; background: linear-gradient(135deg,#f4a3a8,#8fc8b5); }
.tab-bar-text { margin-top: 4rpx; font-size: 22rpx; }
