# 本文件仅列出需要在 shell 或部署平台中设置的环境变量；服务不会自动读取 .env。
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./server/data/app.db
DATABASE_ENGINE=sqlite
AUTH_SECRET=replace-with-a-long-random-secret
# 使用 `openssl rand -hex 32` 生成；不要与 AUTH_SECRET 相同。
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=primary
SEED_DEMO_DATA=true
TOKEN_TTL_SECONDS=28800
MAX_BODY_BYTES=1048576
CORS_ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
GENERAL_RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false
LOG_LEVEL=info
# 生产环境建议配置，供监控系统抓取 /metrics 时使用。
METRICS_TOKEN=

# DATABASE_ENGINE=mysql 时必填；生产必须同时提供 MYSQL_SSL_CA。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shuzhi
MYSQL_USER=shuzhi_app
MYSQL_PASSWORD=
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=20
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_QUEUE_LIMIT=1000
